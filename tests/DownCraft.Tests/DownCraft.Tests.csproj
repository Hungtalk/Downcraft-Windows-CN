<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>DownCraft.Tests</RootNamespace>
    <AssemblyName>DownCraft.Tests</AssemblyName>
    <!-- CA1861/xUnit1051 are style-only in tests (literal arrays are clearer than fields). -->
    <NoWarn>$(NoWarn);CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

  <!--
    xunit.v3 runs on Microsoft.Testing.Platform (MTP). The root global.json selects the MTP
    runner for `dotnet test`, which the .NET 10 SDK requires (VSTest mode is deprecated there).
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownCraft.Core\DownCraft.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
