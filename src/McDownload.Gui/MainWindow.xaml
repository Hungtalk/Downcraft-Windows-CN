<Window x:Class="McDownload.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:McDownload.Gui"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="McDownload — Minecraft 下载器"
        Height="720" Width="1060" MinHeight="500" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16" Background="#101828">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9" Background="#2563EB" Margin="0,0,12,0">
                        <TextBlock Text="MC" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="McDownload" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="为不支持下载的启动器准备原版与 Forge / NeoForge / Fabric / Quilt"
                                   Foreground="#98A2B3" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="v1.0" Foreground="#667085" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="368" MinWidth="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: settings -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="游戏目录（.minecraft）" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding GameDirectory}"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Padding="12,7" Click="BrowseButton_Click" />
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource SecondaryButton}"
                                        Margin="6,0,0,0" Padding="12,7" Click="OpenFolderButton_Click" />
                            </Grid>
                            <TextBlock Text="安装结果就是这个目录，HMCL / PCL2 / Prism / 官方启动器都能识别。"
                                       Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="版本与 Mod 加载器" Style="{StaticResource CardTitle}" />

                            <TextBlock Text="Minecraft 版本" FontSize="12" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="True"
                                          ItemsSource="{Binding Versions}"
                                          Text="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="可直接输入版本号，例如 1.20.1 / 1.21.4 / 26.3" />
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Padding="10,6" Click="RefreshVersionsButton_Click" />
                            </Grid>

                            <TextBlock Text="加载器" FontSize="12" Foreground="{StaticResource Brush.Muted}" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding Loaders}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedLoader}" SelectionChanged="LoaderComboBox_SelectionChanged" />

                            <TextBlock Text="加载器版本（留空 = 最新稳定版）" FontSize="12" Foreground="{StaticResource Brush.Muted}" Margin="0,10,0,4" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding LoaderVersions}"
                                      Text="{Binding SelectedLoaderVersion, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LoaderVersionEnabled}"
                                      ToolTip="例如 Forge 47.4.28、Fabric 0.16.9、NeoForge 21.1.265" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="下载选项" Style="{StaticResource CardTitle}" />

                            <CheckBox IsChecked="{Binding DownloadAssets}">
                                <TextBlock Text="下载资源文件（贴图 / 声音，约 200–700 MB）" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding WriteLauncherProfile}">
                                <TextBlock Text="写入 launcher_profiles.json（启动器自动识别）" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AutoJava}">
                                <TextBlock Text="需要时自动下载 Mojang Java 运行时" TextWrapping="Wrap" />
                            </CheckBox>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="并发下载数" FontSize="12" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ParallelismOptions}" SelectedItem="{Binding SelectedParallelism}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="下载源策略" FontSize="12" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding SourceModes}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedSourceMode}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,10,6,0" Background="{StaticResource Brush.Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="开始下载 / 安装" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanStart}" Click="InstallButton_Click" />
                    <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            IsEnabled="{Binding IsBusy}" Click="CancelButton_Click" />
                    <Button Grid.Column="2" Content="校验文件" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            IsEnabled="{Binding CanStart}" Click="VerifyButton_Click" />
                </Grid>
            </Grid>

            <!-- Right: status + log -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Height="8" Margin="0,10,0,6" BorderThickness="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                     Background="#EAECF0" Foreground="{StaticResource Brush.Accent}" />
                        <Grid>
                            <TextBlock Text="{Binding ProgressDetail}" Foreground="{StaticResource Brush.Muted}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource Brush.Muted}" FontSize="12"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding SummaryText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="日志" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                            <Button Content="清空" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                    Padding="10,4" FontSize="11" Click="ClearLogButton_Click" />
                        </Grid>
                        <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogLines}"
                                 BorderThickness="0" Background="#FBFCFE"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="2,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontSize="12"
                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock Text="{Binding FooterText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" />
                <TextBlock Text="{Binding NativeStatusText}" Foreground="{StaticResource Brush.Muted}" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
